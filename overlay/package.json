{
  "name": "cward-overlay",
  "private": true,
  "version": "1.0.2",
  "author": "JeongHoon Lim <hoony6134@gmail.com>",
  "type": "module",
  "description": "cward macOS menu-bar app: phone pairing (no terminal) + in-game overlay",
  "main": "src/main.mjs",
  "scripts": {
    "bundle:main": "esbuild src/main.mjs --bundle --platform=node --format=esm --packages=external --outfile=build/main.mjs && cp src/preload.cjs build/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run bundle:main && npm run build:renderer",
    "start": "pkill -f 'ward/overlay/node_modules/electron' 2>/dev/null; sleep 0.3; npm run build:renderer && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "xyz.scian.cward",
    "productName": "cward",
    "extraMetadata": { "main": "build/main.mjs" },
    "artifactName": "cward-overlay-macos-${arch}.dmg",
    "files": ["build/**", "renderer/**", "renderer-dist/**"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": "VOID (KR) (2S9H42VJUA)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": { "teamId": "2S9H42VJUA" }
    }
  }
}
