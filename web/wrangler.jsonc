{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ward-web",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "ward.gg.scian.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
